# Google Maps Platform API Key (Directions API & Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=

# Rainfall provider mode: DEMO (default) or LIVE
VITE_RAINFALL_PROVIDER=DEMO

# Real-time rainfall API — used only when VITE_RAINFALL_PROVIDER=LIVE.
# Do not commit real keys; placeholders only.
VITE_RAINFALL_API_URL=
VITE_RAINFALL_API_KEY=

# Request timeout (ms) and staleness window (ms) for live rainfall data
VITE_RAINFALL_API_TIMEOUT_MS=6000
VITE_RAINFALL_STALE_MS=1800000
